%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% cv.tex.j2 — Jinja2 template for Scott A. Love's CV
% Rendered by:  scripts/generate_latex.py
% Output:       build/cv.tex
%
% Requires moderncv.cls and the accompanying .sty files to be in
% the same directory as the compiled .tex file (copy from templates/).
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

{% set p = personal %}
{% set theme = cv.theme %}
{# Section ordering: falls back to a sensible default when section_order is
   absent from cv.yaml (backward compatibility). #}
{% set default_section_order = [
     'education',
     'professional_experience',
     'funding',
     'honors_awards',
     'languages',
     'publications',
     'conference_presentations',
   ] %}
{% set section_order = cv.get('section_order', default_section_order) %}
{# Reverse-number publications when pub_reverse_numbering: true #}
{% set pub_reverse = cv.get('pub_reverse_numbering', false) %}

%-------------------------------------------------------------------
%  DOCUMENT CLASS & THEME
%-------------------------------------------------------------------
\documentclass[11pt,a4paper,sans]{moderncv}

\moderncvstyle{ {{- theme.style -}} }   % casual | classic | oldstyle | banking | empty
\moderncvcolor{ {{- theme.color -}} }   % blue | orange | green | red | purple | grey | black

\usepackage[utf8]{inputenc}
\usepackage[T1]{fontenc}
\usepackage[scale=.84]{geometry}
\setlength{\hintscolumnwidth}{2.5cm}

%-------------------------------------------------------------------
%  PERSONAL INFORMATION
%-------------------------------------------------------------------
\firstname{ {{- p.firstname | escape_latex -}} }
\familyname{ {{- p.familyname | escape_latex -}} }
{% if p.title %}\title{ {{- p.title | escape_latex -}} }{% endif %}
{% if p.email %}\email{ {{- p.email -}} }{% endif %}
{% if p.mobile %}\mobile{ {{- p.mobile | escape_latex -}} }{% endif %}
{% if p.homepage %}\homepage{ {{- p.homepage -}} }{ {{- p.homepage -}} }{% endif %}
{% if p.orcid or p.id_hal %}\extrainfo{ {% if p.orcid %}ORCID: orcid.org/{{ p.orcid }}{% endif %}{% if p.orcid and p.id_hal %} \enspace|\enspace {% endif %}{% if p.id_hal %}HAL: hal.science/{{ p.id_hal }}{% endif %} }{% endif %}
{% if p.photo %}\photo[70pt][0.4pt]{ {{- p.photo -}} }{% endif %}

%-------------------------------------------------------------------

\begin{document}

\makecvtitle

{# ---------------------------------------------------------------- #}
{# Helper macro: render an author list, bolding the target author.  #}
{# Only the first token (Surname) is matched to avoid false-bolding  #}
{# adjacent names that share text with the target surname.           #}
{# ---------------------------------------------------------------- #}
{%- macro render_authors(authors) -%}
  {%- for a in authors -%}
    {%- if a[:5] == "Love," or a[:5] == "Love " -%}
      \textbf{ {{- a -}} }
    {%- else -%}
      {{- a -}}
    {%- endif -%}
    {%- if not loop.last -%}, {% endif -%}
  {%- endfor -%}
{%- endmacro -%}

{# ================================================================ #}
{# SECTION LOOP — rendered in section_order                         #}
{# ================================================================ #}

{% for sec in section_order %}

{# ---------------------------------------------------------------- #}
{% if sec == 'education' %}
%-------------------------------------------------------------------
%  EDUCATION
%-------------------------------------------------------------------
\section{Education}

{% for edu in education -%}
{%- set date_str = edu.start ~ " -- " ~ edu.end if edu.end else edu.start ~ " -- present" -%}
\cventry{ {{- date_str -}} }{ {{- edu.degree | escape_latex -}} }{}{}{}{ {{- edu.honours | default("") | escape_latex -}} }
{% if edu.thesis_title %}\cvitem{Title}{\emph{ {{- edu.thesis_title | escape_latex -}} }}{% endif %}
{% if edu.supervisor %}\cvitem{Supervisor}{ {{- edu.supervisor | escape_latex -}} }{% endif %}
{% if edu.description %}\cvitem{Description}{ {{- edu.description | escape_latex -}} }{% endif %}

{% endfor %}

{# ---------------------------------------------------------------- #}
{% elif sec == 'professional_experience' %}
%-------------------------------------------------------------------
%  PROFESSIONAL EXPERIENCE
%-------------------------------------------------------------------
\section{Professional Experience}

{% if experience.research %}
\subsection{Research}
{% for job in experience.research -%}
{%- set date_str = job.start ~ " -- " ~ (job.end if job.end else "present") -%}
\cventry{ {{- date_str -}} }{ {{- job.position | escape_latex -}} }{ {{- job.institution | escape_latex -}} }{ {{- job.country | escape_latex -}} }{}{}
{% if job.team %}\cvitem{Team}{ {{- job.team | escape_latex -}} }{% endif %}
{% if job.supervisor %}\cvitem{Supervisor}{ {{- job.supervisor | escape_latex -}} }{% endif %}
{% if job.description %}\cvitem{Description}{ {{- job.description | escape_latex -}} }{% endif %}

{% endfor %}
{% endif %}

{% if experience.teaching %}
\subsection{Teaching}
{% for job in experience.teaching -%}
{%- if job.start is defined and job.end is defined -%}
  {%- set date_str = job.start ~ " -- " ~ job.end -%}
{%- elif job.year is defined -%}
  {%- set date_str = job.year | string -%}
{%- else -%}
  {%- set date_str = "" -%}
{%- endif -%}
\cventry{ {{- date_str -}} }{ {{- job.course | escape_latex -}} }{ {{- job.institution | escape_latex -}} }{}{}{ {{- job.notes | default("") | escape_latex -}} }
{% endfor %}
{% endif %}

{# ---------------------------------------------------------------- #}
{% elif sec == 'funding' %}
{% if funding %}
%-------------------------------------------------------------------
%  FUNDING
%-------------------------------------------------------------------
\section{Funding}

{% for grant in funding -%}
\cvitem{ {{- grant.years | escape_latex -}} }{ {{- grant.description | escape_latex -}} }
{% endfor %}
{% endif %}

{# ---------------------------------------------------------------- #}
{% elif sec == 'honors_awards' %}
{% if honors_awards %}
%-------------------------------------------------------------------
%  HONORS & AWARDS
%-------------------------------------------------------------------
\section{Honors \& Awards}

{% for award in honors_awards -%}
\cvitem{ {{- award.year -}} }{ {{- award.award | escape_latex -}} }
{% endfor %}
{% endif %}

{# ---------------------------------------------------------------- #}
{% elif sec == 'languages' %}
{% if languages %}
%-------------------------------------------------------------------
%  LANGUAGES
%-------------------------------------------------------------------
\section{Languages}

{% for lang in languages -%}
\cvitemwithcomment{ {{- lang.language | escape_latex -}} }{ {{- lang.proficiency | escape_latex -}} }{ {{- lang.scale | default("") | escape_latex -}} }
{% endfor %}
{% endif %}

{# ---------------------------------------------------------------- #}
{% elif sec == 'publications' %}
%-------------------------------------------------------------------
%  PUBLICATIONS
%-------------------------------------------------------------------
\section{Publications}

{% if publications.journal_articles %}
\subsection{Peer-reviewed articles}

{% for pub in publications.journal_articles -%}
\cvitem{ {{- pub.index -}} }{ {{- render_authors(pub.authors) }} {{ pub.year }}. {{ pub.title | escape_latex }} \textit{ {{- pub.journal | escape_latex -}} }{% if pub.volume %} {{ pub.volume }}{% endif %}{% if pub.pages %}, {{ pub.pages }}{% endif %}{% if pub.doi %} \url{ {{- pub.doi -}} }{% endif %}}
{% endfor %}
{% endif %}

{% if publications.book_chapters %}
\subsection{Book chapters}

{% for pub in publications.book_chapters -%}
\cvitem{ {{- pub.index -}} }{ {{- render_authors(pub.authors) }} {{ pub.year }}. {{ pub.title | escape_latex }}{% if pub.editors %}, in: {{ pub.editors | join(", ") }} (Eds.){% endif %}, \textit{ {{- pub.book | escape_latex -}} }{% if pub.publisher %}, {{ pub.publisher | escape_latex }}{% endif %}}
{% endfor %}
{% endif %}

{% if publications.under_review_or_in_prep %}
\subsection{Under review or in preparation}

{% for pub in publications.under_review_or_in_prep -%}
{%- if pub.authors and pub.authors | length > 0 -%}
  {%- set author_str = render_authors(pub.authors) -%}
{%- else -%}
  {%- set author_str = pub.title -%}
{%- endif -%}
\cvitem{ {{- pub.index -}} }{ {{- author_str -}}{% if pub.authors and pub.authors | length > 0 and pub.year %} ({{ pub.year }}){% endif %}{% if pub.authors and pub.authors | length > 0 and pub.title %}. {{ pub.title | escape_latex }}{% endif %}{% if pub.journal %} \textit{ {{- pub.journal | escape_latex -}} }{% endif %}{% if pub.status %} ({{ pub.status | escape_latex }}){% endif %}}
{% endfor %}
{% endif %}

{# ---------------------------------------------------------------- #}
{% elif sec == 'conference_presentations' %}
{% if conference_presentations %}
%-------------------------------------------------------------------
%  CONFERENCE PRESENTATIONS
%-------------------------------------------------------------------
\section{Conference Presentations}

{% for pres in conference_presentations -%}
\cvitem{ {{- pres.index -}} }{ {{- render_authors(pres.authors) }} {{ pres.year }}. {{ pres.title | escape_latex }}.{% if pres.venue %} {{ pres.type | title }} at {{ pres.venue | escape_latex }}{% if pres.location %}, {{ pres.location | escape_latex }}{% endif %}{% if pres.date %}, {{ pres.date }}{% endif %}{% else %} {{ pres.type | title }}{% endif %}}
{% endfor %}
{% endif %}

{% endif %}
{% endfor %}

\end{document}
